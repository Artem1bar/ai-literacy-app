{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "PATH=/opt/homebrew/opt/node@22/bin:$PATH pnpm --dir frontend dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "backend",
        "run",
        "uvicorn",
        "main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
