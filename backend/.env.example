# Copy to backend/.env and fill in. Never commit the filled-in file.

# Anthropic API key used by the Prompt Lab proxy (POST /api/prompt).
# Server-side only — it is never sent to the browser. Leave blank and the
# API still starts, but /api/prompt returns an authentication error.
ANTHROPIC_API_KEY=

# Comma-separated CORS origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# slowapi rate-limit string applied per client IP to /api/prompt.
RATE_LIMIT=10/minute

# Job listings come from a stub until the Star Jobs API is public.
# Set to false to switch to the HTTP client once one exists.
STARJOBS_STUB=true
