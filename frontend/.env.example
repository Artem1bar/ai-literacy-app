# Copy to frontend/.env.local (Vite reads it automatically; it is git-ignored).

# Base URL of the FastAPI backend. Setting it is what switches on the
# Prompt Lab and the Louisiana occupation explorer; unset, the build is the
# static course (home, modules, glossary, resources, profile) and never calls
# a backend — this is what the Vercel deployment does.
#   local dev:        http://localhost:8000  (uvicorn from backend/)
#   self-hosted:      the backend's public URL, or "/" for same origin
VITE_API_URL=http://localhost:8000
